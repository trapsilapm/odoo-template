# ==============================================================================
# Odoo & Hermes Agent (Option 2 - Dedicated Bot & Isolated Container)
# ==============================================================================

# LLM Provider Configuration (DeepSeek API)
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Alternative LLM Providers (Gemini / OpenAI)
# LLM_PROVIDER=gemini
# LLM_API_KEY=your_gemini_api_key_here

# Telegram Bot Token (Khusus Bot Odoo dari @BotFather)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Odoo Internal Connection (Untuk Hermes XML-RPC Bridge)
ODOO_URL=http://web:8069
ODOO_DB=postgres
ODOO_USER=admin
ODOO_PASSWORD=SuperSecretPassword123!

# Security & Master Passwords
ODOO_ADMIN_PASSWORD=MasterPasswordMasterKey123!
POSTGRES_PASSWORD=SuperSecretPassword123!
POSTGRES_USER=odoo
